{
  "name": "jikadara-erp-server",
  "version": "1.0.0",
  "description": "Gujarati ERP Lite — Node.js/Express/Prisma backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:pull": "prisma db pull",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset --force",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:constraints": "ts-node --transpile-only scripts/apply-constraints.ts",
    "backup": "ts-node scripts/backup.ts",
    "backup:auth": "ts-node scripts/backup-auth.ts",
    "backup:list": "ts-node scripts/backup-list.ts",
    "backup:restore": "ts-node scripts/backup-restore.ts",
    "db:preflight": "ts-node --transpile-only scripts/preflight-db.ts",
    "db:baseline": "prisma migrate resolve --applied 20261110000000_baseline",
    "release": "npm run db:preflight && prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@types/multer": "^2.2.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "googleapis": "^189.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.4.0",
    "officecrypto-tool": "^0.0.19",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "prisma": "^5.14.0",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^5.1.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "overrides": {
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "body-parser": "1.20.9",
    "proxy-addr": "2.0.8",
    "qs": "6.17.1",
    "uuid": "11.1.1"
  }
}
