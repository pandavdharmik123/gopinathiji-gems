# Server Environment Variables
# Copy this file to .env and fill in your values

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/gopinathji_gems

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=2h

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:8443

# ─── Bcrypt ────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Gopinathji Gems <no-reply@gopinathjigems.com>

# ─── Brevo (optional) ──────────────────────────────────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# ─── Keep-Alive (Render.com / production) ──────────────────────────────────────
# OFF by default. Self-pinging keeps the instance awake 24/7 and consumes
# Render's instance-hour allowance. Only enable if you want an always-on server.
KEEP_ALIVE_ENABLED=false
# Set either of these when hosted on Render; RENDER_EXTERNAL_URL is set automatically.
# SERVER_URL=https://your-app.onrender.com
# RENDER_EXTERNAL_URL=https://your-app.onrender.com

# ─── Google Drive Database Backup ─────────────────────────────────────────────
GOOGLE_DRIVE_BACKUP_ENABLED=false
PROJECT_NAME=gopinathji-gems

# OAuth2 credentials — create at https://console.cloud.google.com/
# Enable: Google Drive API + Google People API
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5555/oauth2callback

# Populated automatically by running: npm run backup:auth
GOOGLE_DRIVE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_BACKUP_FOLDER_ID=

# Backup schedule (cron expression, default: 2am IST daily)
DB_BACKUP_SCHEDULE=0 2 * * *
DB_BACKUP_TIMEZONE=Asia/Kolkata

# Retention policy
DB_BACKUP_KEEP_DAILY=30
DB_BACKUP_KEEP_WEEKLY=12
DB_BACKUP_KEEP_MONTHLY=12

# Optional AES-256-GCM encryption key (must be 32+ characters)
# DB_BACKUP_ENCRYPTION_KEY=your_32_char_minimum_encryption_key
